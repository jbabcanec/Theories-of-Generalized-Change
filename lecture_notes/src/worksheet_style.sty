\ProvidesPackage{worksheet_style}[2026/04/01 MATH241 Worksheet Style]

% ---- No paragraph indents ----
\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt plus 1pt minus 1pt}

% ---- Core Packages ----
